# ══════════════════════════════════════════════════════════════════════════════
# NovaOps Environment Variables
# Copy this to .env for local dev. For Vercel: Dashboard → Project → Settings →
# Environment Variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use the SAME project as your mobicare-business website deployment so
# tickets/customers/inventory and website bookings live side by side.
# From: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

