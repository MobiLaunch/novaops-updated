# NovaOps environment variables
# Copy to .env for local development. On Vercel: Project → Settings → Environment Variables.

# ── Supabase (browser) ────────────────────────────────────────────────────────
# From https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server only. Used by api/fetch-emails and api/send-email. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Square (point of sale) ────────────────────────────────────────────────────
# From https://developer.squareup.com → Apps → your app → Credentials.
# These are server-side fallbacks; shops normally save their own in Settings → Integrations.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_SANDBOX=false
# Browser-visible defaults for the Web Payments SDK
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_SANDBOX=false

# ── Trade-in price lookup ─────────────────────────────────────────────────────
# From https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── EmailJS (customer notifications) ──────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CUSTOMER=

# ── Social sign-in (enable the providers in Supabase Auth first) ──────────────
VITE_SOCIAL_GOOGLE=false
VITE_SOCIAL_FACEBOOK=false

# ── Gmail sync / outbound email (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
