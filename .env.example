# ══════════════════════════════════════════════════════════════════════════════
# NovaOps Environment Variables
# Copy this to .env for local dev. For Vercel: Dashboard → Project → Settings →
# Environment Variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (browser) ──────────────────────────────────────────────────────
# Use the SAME project as your mobicare-business website deployment so
# tickets/customers/inventory and website bookings live side by side.
# From: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server, for api/fetch-emails + api/send-email) ───────────────
# Service role key — NEVER expose to the browser. Server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Square (POS payments + terminal) ────────────────────────────────────────
# From: https://developer.squareup.com → Apps → your app → Credentials
# Can also be set per-shop from Settings instead (sent as request headers).
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=L...
SQUARE_APPLICATION_ID=sq0idp-...   # Needed by the Web Payments SDK
SQUARE_SANDBOX=false

# ── Trade-in device price lookup ────────────────────────────────────────────
# Optional Tier-2 fallback when PriceCharting (no key needed) has no match.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Email (Messages page: fetch-emails / send-email) ────────────────────────
# Gmail OAuth (per-profile tokens live in the social_connections table):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# SMTP fallback (used if Gmail isn't connected for the profile):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=you@example.com

# ══════════════════════════════════════════════════════════════════════════════
# Not yet wired into the app (business logic preserved for reference only):
# PWA/offline, Electron desktop shell. See README.md "Migration Status".
# ══════════════════════════════════════════════════════════════════════════════
