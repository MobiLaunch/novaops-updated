{
  "name": "novaops",
  "version": "6.0.0",
  "description": "NovaOps — Repair Shop Management (Vite + React 19 + HeroUI 3)",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "3.2.4",
    "@supabase/supabase-js": "^2.96.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.23.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "8.5.15",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.3.1",
    "typescript": "^5.5.4",
    "vite": "8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.15"
  },
  "build": {
    "appId": "com.novaops.desktop",
    "productName": "NovaOps",
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "public/icon-192.png",
      "public/icon-512.png",
      "public/icon.ico",
      "package.json"
    ],
    "mac": { "icon": "public/icon-512.png", "category": "public.app-category.business" },
    "win": { "icon": "public/icon.ico" },
    "linux": { "icon": "public/icon-512.png", "category": "Office" }
  }
}
